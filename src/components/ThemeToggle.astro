---
// ThemeToggle.astro — Light/Dark toggle with no-flash SSR
// Uses inline script to apply saved theme before paint
---

<script is:inline>
  (function () {
    try {
      const saved = localStorage.getItem("blogTheme");
      const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
      const theme = saved || (prefersDark ? "dark" : "light");
      document.documentElement.setAttribute("data-theme", theme);
    } catch {
      document.documentElement.setAttribute("data-theme", "dark");
    }
  })();
</script>

<button
  id="theme-toggle"
  class="theme-toggle"
  aria-label="Toggle theme"
  title="Toggle theme"
  type="button"
>
  <svg class="icon-sun" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <circle cx="12" cy="12" r="5"></circle>
    <line x1="12" y1="1" x2="12" y2="3"></line>
    <line x1="12" y1="21" x2="12" y2="23"></line>
    <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
    <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
    <line x1="1" y1="12" x2="3" y2="12"></line>
    <line x1="21" y1="12" x2="23" y2="12"></line>
    <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
    <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
  </svg>
  <svg class="icon-moon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
  </svg>
</button>

<style>
  .theme-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border: 1px solid var(--tn-color-accent);
    border-radius: var(--tn-border-radius);
    background: var(--tn-color-secondary-background);
    color: var(--tn-color-text);
    cursor: pointer;
    transition: background 0.2s ease, border-color 0.2s ease, transform 0.1s ease;
  }

  .theme-toggle:hover {
    background: var(--tn-color-accent);
    border-color: var(--tn-color-contrast);
  }

  .theme-toggle:active {
    transform: scale(0.95);
  }

  .theme-toggle:focus-visible {
    outline: 2px solid var(--tn-color-accent);
    outline-offset: 2px;
  }

  .theme-toggle svg {
    width: 20px;
    height: 20px;
    display: none;
  }

  :root[data-theme="light"] .icon-sun,
  :root[data-theme="dark"] .icon-moon,
  :root[data-theme="cozy-rose"] .icon-moon,
  :root[data-theme="chill-aqua"] .icon-moon,
  :root[data-theme="wild-forest"] .icon-moon,
  :root[data-theme="neon-orbit"] .icon-moon {
    display: block;
  }
</style>

<script>
  const btn = document.getElementById("theme-toggle");
  if (btn) {
    btn.addEventListener("click", () => {
      const html = document.documentElement;
      const current = html.getAttribute("data-theme");
      const isDark = current === "dark" || current === "neon-orbit";
      const next = isDark ? "light" : "dark";
      html.setAttribute("data-theme", next);
      try {
        localStorage.setItem("blogTheme", next);
      } catch { /* ignore localStorage errors */ }
      window.dispatchEvent(new CustomEvent("themeChanged", { detail: { theme: next } }));
    });
  }
</script>