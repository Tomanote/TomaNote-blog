---
// LanguageToggle.astro — EN/ES language switcher
import { getCollection } from "astro:content";

const locale = Astro.currentLocale || "en";
const isSpanish = locale === "es";
const pathname = Astro.url.pathname;

// Fetch all posts to find the alternate language slug
const posts = await getCollection("blog", ({ data }) => !data.draft);

// Extract the current slug from the pathname
// Patterns: /blog/{slug}/ or /blog/es/{slug}/
let currentSlug = "";
let currentPostLocale = "";
const blogMatch = pathname.match(/^\/blog\/(es\/)?([^/]+)\/?$/);
if (blogMatch) {
  currentPostLocale = blogMatch[1] ? "es" : "en";
  currentSlug = blogMatch[2];
}

// Find the current post and its i18nSlug
let alternateSlug = "";
if (currentSlug) {
  const currentPost = posts.find((p) => {
    const [postLocale, ...slugParts] = p.id.split("/");
    const slug = slugParts.join("/");
    return postLocale === currentPostLocale && slug === currentSlug;
  });
  if (currentPost?.data.i18nSlug) {
    alternateSlug = currentPost.data.i18nSlug;
  }
}

// Build the alternate language URL
function buildAltHref(): string {
  // If on a blog post page with a known alternate slug
  if (currentSlug && alternateSlug) {
    if (isSpanish) {
      // ES blog → EN blog: /blog/es/{slug}/ → /blog/{altSlug}/
      return `/blog/${alternateSlug}/`;
    }
    // EN blog → ES blog: /blog/{slug}/ → /blog/es/{altSlug}/
    return `/blog/es/${alternateSlug}/`;
  }

  // For non-blog pages, just swap the locale prefix
  if (pathname.startsWith("/es/")) {
    return isSpanish ? pathname.replace("/es/", "/") : pathname;
  }
  if (pathname === "/es/") {
    return "/";
  }
  return `/${isSpanish ? "" : "es"}${pathname}`;
}

const altHref = buildAltHref();
const altLabel = isSpanish ? "English" : "Español";
const altLangCode = isSpanish ? "en" : "es";
---

<a
  href={altHref}
  class="lang-toggle"
  aria-label={`Switch to ${altLabel}`}
  title={altLabel}
  hreflang={altLangCode}
>
  {isSpanish ? "EN" : "ES"}
</a>

<style>
  .lang-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 40px;
    height: 40px;
    padding: 0 0.5rem;
    border: 1px solid var(--tn-color-accent);
    border-radius: var(--tn-border-radius);
    background: var(--tn-color-secondary-background);
    color: var(--tn-color-text);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    cursor: pointer;
    text-decoration: none;
    transition: background 0.2s ease, border-color 0.2s ease;
  }

  .lang-toggle:hover {
    background: var(--tn-color-accent);
    border-color: var(--tn-color-contrast);
    color: var(--tn-color-background);
  }

  .lang-toggle:focus-visible {
    outline: 2px solid var(--tn-color-accent);
    outline-offset: 2px;
  }
</style>
