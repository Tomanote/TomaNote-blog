---
// BlogLayout.astro — Layout for blog pages with header/footer
import BaseLayout from "./BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  ogType?: "website" | "article";
  article?: {
    publishedTime?: string;
    modifiedTime?: string;
    authors?: string[];
    tags?: string[];
  };
  noIndex?: boolean;
}
---

<BaseLayout {...Astro.props}>
  <Header slot="header" />
  <slot />
  <Footer slot="footer" />
</BaseLayout>